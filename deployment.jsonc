{
  // Cloudflare account that owns every Worker and provisioned resource.
  "accountId": "84f114e1b747a07d247ceb17b0c1dc14",

  // Voltrix production domain. null derives from customDomain below.
  "publicBaseUrl": null,

  "workers": {
    "router": {
      "name": "voltrix-router",
      // Production domain — Wrangler will create DNS + TLS on first deploy
      "route": { "customDomain": "voltrix.stream" }
    },
    "workshop":        { "name": "voltrix-workshop" },
    "context":         { "name": "voltrix-context" },
    "scheduler":       { "name": "voltrix-scheduler" },
    "customGatekeeper":{ "name": "voltrix-academic" },
    "errorReporter":   { "name": "voltrix-errors" }
  },

  // Using built-in password accounts (not Cloudflare Access)
  // so students can self-register without a CF Access app.
  // Reference: docs/customization.md#sign-in-methods
  "access": {
    "issuer": "https://voltrix.cloudflareaccess.com",
    "audience": "REPLACE_WITH_ACCESS_AUDIENCE",
    "admins": ["captain8888ping@gmail.com"]
  },

  // Model catalog served through Cloudflare AI Gateway. Enabled by default: the Workshop reaches
  // the gateway over its WORKERS_AI binding, which is pre-authenticated inside your own account,
  // so no API token is needed.
  // Reference: docs/customization.md#ai-models
  "aiGateway": {
    "enabled": true,
    // "voltrix-ai" gateway — create this in the CF dashboard AI Gateway section
    "name": "voltrix-ai",
    "accountId": null,
    // Workers AI (free) + Google Gemini 2.5 Pro for quality academic tasks
    // Google requires CF_AI_GATEWAY_API_TOKEN — set via wrangler secret
    "providers": ["cloudflare", "google"]
  },

  "context": {
    // Isolates Context data shared by this Workshop deployment.
    // null scopes it to the public origin
    "sharingDomain": null,

    // null: Wrangler provisions and remembers a KV namespace on first deploy.
    // string: bind an existing namespace by ID.
    "kvNamespaceId": null

    // Optional Git-compatible storage for Context collections. To enable it, add a comma after
    // kvNamespaceId and uncomment this object. Requires Artifacts account access.
    // "artifacts": {
    //   "enabled": true,
    //   // Optional override; defaults to "gatekeeper-context-collections".
    //   "namespace": "custom-context-collections"
    // }
  },

  // Voltrix academic Gatekeeper — exposes flashcards, SM-2, exam prediction,
  // document generation, and Pesapal payments to the CF OS agent.
  "customGatekeeper": {
    "name": "Voltrix Academic",
    "message": "You are Volt, an expert AI academic copilot for university students. You help with essays, reports, flashcards, exam prediction, and all coursework. Always address the student by name from their profile. Be thorough, accurate, and encouraging."
  },

  // Explicit backend issue reports go to a private Worker that emits structured console errors.
  // Set release to a commit/version when your deployment pipeline has one.
  // Reference: docs/observability.md#quick-start
  "errorReporting": {
    "enabled": true,
    "environment": "production",
    "release": null
  },

  // null values use Wrangler automatic provisioning. Set IDs/names to reuse owned resources.
  // https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
  "resources": {
    "blueprintsKvNamespaceId": null,
    "avatarsKvNamespaceId": null,
    "blueprintContentBucket": null
  },

  // Structured custom logs stay enabled. Invocation logs and traces are separate volume controls.
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}

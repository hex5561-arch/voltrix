# Fill in any providers you have. Each one shows up in the app's Provider menu.
# Every *_MODEL and *_BASE_URL below is optional and overrides the default.

# --- Speech-to-speech (lowest delay) ---
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-realtime

# --- Chat models (listen -> think -> speak) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b
SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_MODEL=llama3.2          (set to enable a local Ollama)
# CUSTOM_BASE_URL=https://any-openai-compatible-server/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
# CUSTOM_LABEL=My server
# (GEMINI_API_KEY and OPENAI_API_KEY also enable their chat models here.)

# --- Hearing and speaking for chat models ---
# Transcription: uses Groq Whisper if GROQ_API_KEY is set, else OpenAI, else the browser (Chrome).
# STT_BASE_URL= STT_API_KEY= STT_MODEL=
# Voice: uses OpenAI voices if OPENAI_API_KEY is set, else the browser's built-in voices.
# TTS_BASE_URL= TTS_API_KEY= TTS_MODEL= TTS_VOICES=voice1,voice2

PORT=3000

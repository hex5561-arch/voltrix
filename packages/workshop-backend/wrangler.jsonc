{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voltrix-workshop",
  "main": ".wrangler/validate/src/server.ts",
  "build": {
    "command": "pnpm run build:worker",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",

  // `global_fetch_strictly_public` makes the global fetch() function strictly fetch from
  // the public internet in production, rather than the legacy behavior in which same-zone
  // requests go directly to origin bypassing Cloudflare. This flag is important to protect
  // against SSRF, particularly in the webFetch agent tool, but also generally.
  //
  // When self-hosting with `workerd` stand-alone, it is already the default behavior that the
  // global fetch() function blocks private-network IP addresses or hostnames that resolve to such
  // addresses.
  //
  // Note that `wrangler dev` intentionally reconfigures its global outbound to permit fetching
  // from any address (so local services on localhost stay reachable), so this flag effectively
  // only takes effect in production or when running workerd stand-alone. That's an acceptable
  // tradeoff for dev.
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "enhanced_error_serialization",
    "global_fetch_strictly_public",

    // The pi-ai inference layer wraps the official provider SDKs (@anthropic-ai/sdk, openai,
    // @google/genai), which need Node compatibility. Puppeteer (used for Gadget PDF exports)
    // also requires Node compatibility. Otherwise, we'd only need nodejs_als.
    "nodejs_compat"
  ],

  // Wrangler will launch a Chrome instance locally to emulate the Browser Run API during
  // local development. Add "remote": true to use a remote browser running on Cloudflare instead.
  "browser": {
    "binding": "BROWSER"
  },

  // Gatekeeper service bindings and the Workers AI binding are dynamically
  // added by run-dev-server.ts (for dev) and generate-wrangler-prod.js (for
  // production).

  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [ "UserDurableObject", "OverseerDurableObject" ]
    },
    {
      "tag": "v1",
      "new_sqlite_classes": [ "AdminSettings" ]
    },
    {
      // Sign-in via authentication gatekeepers: a short-lived PendingLogin DO bridges each gatekeeper
      // login back to the waiting browser.
      "tag": "v2",
      "new_sqlite_classes": [ "PendingLogin" ]
    }
  ],

  // All DO classes (UserDurableObject, OverseerDurableObject, AdminSettings, PendingLogin, ...) are
  // reached via ctx.exports and need no explicit durable_objects binding.
  "kv_namespaces": [
    {
      "binding": "BLUEPRINTS",
      "id": "8b03b72e6b864d6c853e3a14f0ac90f0"
    },
    {
      "binding": "AVATARS",
      "id": "95afee60f1a24fdd811f86d5e28a87bb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLUEPRINT_CONTENT",
      "bucket_name": "voltrix-workshop-blueprint-content"
    }
  ],
  "services": [
    {
      "binding": "ERROR_REPORTER",
      "service": "voltrix-errors",
      "entrypoint": "ErrorReporter"
    },
    {
      "binding": "GATEKEEPER_CONTEXT",
      "service": "voltrix-context",
      "entrypoint": "GatekeeperVendor"
    },
    {
      "binding": "GATEKEEPER_CUSTOM",
      "service": "voltrix-academic",
      "entrypoint": "GatekeeperVendor"
    },
    {
      "binding": "GATEKEEPER_SCHEDULER",
      "service": "voltrix-scheduler",
      "entrypoint": "GatekeeperVendor"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.5 }
  },
  "ai": {
    "binding": "WORKERS_AI"
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://voltrix.stream",
    "CF_AI_GATEWAY": "voltrix-ai",
    "CF_AI_GATEWAY_ACCOUNT_ID": "84f114e1b747a07d247ceb17b0c1dc14",
    "CF_AI_GATEWAY_PROVIDERS": "cloudflare,google,thehive",
    "ADMINS": "[\"captain\"]",
    "WHATSAPP_PHONE_NUMBER_ID": "1380923721763579",
    "WHATSAPP_PHONE_NUMBER": "+256752706401",
    "WHATSAPP_BUSINESS_ACCOUNT_ID": "1289686079850008",
    "WHATSAPP_ACCESS_TOKEN": "EAAPZA5WPDLfgBShj3ZA0AjVfcgwh6fntTFdfevofMsla8mzidIxKIHC8HewzpatK1ZCImhTvRINvb3YWzOJLtJwRFtUgmMxwzcZAB27uZCgGlUtUk5odDlFLZAJPTzgiubZB7yry7x4eAHgm32RqLOafTSVyVKUbLfblHCFkogLziBQL6ATd3kwVWytuZAeYlQZDZD"
  }
}

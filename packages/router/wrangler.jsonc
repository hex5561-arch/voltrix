{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voltrix-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-02",

  // Gatekeeper service bindings (GATEKEEPER_*) are added dynamically at deploy time — by the
  // deploy service for customer instances, from the release manifest's binding templates. Only
  // the static backend binding is checked in.
  "services": [
    {
      "binding": "WORKSHOP_BACKEND",
      "service": "voltrix-workshop"
    },
    {
      "binding": "WHATSAPP",
      "service": "voltrix-whatsapp"
    },
    {
      "binding": "GATEKEEPER_CONTEXT",
      "service": "voltrix-context"
    },
    {
      "binding": "GATEKEEPER_SCHEDULER",
      "service": "voltrix-scheduler"
    },
    {
      "binding": "GATEKEEPER_CUSTOM",
      "service": "voltrix-academic"
    }
  ],

  // The router owns the public origin for customer instances, so it serves the frontend.
  // `run_worker_first: true` ensures every request — including / — runs the worker before
  // hitting the asset cache. This lets the worker redirect http:// → https:// and add
  // security headers (HSTS) on all responses, not just the API/gatekeeper paths.
  // The worker forwards non-API requests to env.ASSETS, so static files are still served
  // efficiently through the CF assets pipeline.
  "assets": {
    "directory": "../workshop-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/blueprint-screenshot",
      "/blueprint-screenshot/*",
      "/gatekeeper/*",
      "/s",
      "/s/*",
      "/solution",
      "/solution/*",
      "/sitemap-solutions.xml"
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}

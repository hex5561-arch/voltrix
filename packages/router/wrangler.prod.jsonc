{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voltrix-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-02",

  "services": [
    {
      "binding": "WORKSHOP_BACKEND",
      "service": "voltrix-workshop"
    }
  ],

  "assets": {
    "directory": "/home/voltrix/voltrix-os/cloudflare-os/packages/workshop-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "routes": [
    {
      "pattern": "os.voltrix.stream/*",
      "zone_id": "fe7a85ed87c3eb7ef5b03aaa769b7a8a"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
